<IfModule mod_rewrite.c>
    RewriteEngine On
RewriteBase / 

# 1. Se o arquivo ou pasta existir fisicamente, acessa diretamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 2. Regras para páginas simples (sem parâmetros)
RewriteRule ^contatos(.*)$ contatos.php [NC,L]
RewriteRule ^sobre(.*)$ sobre.php [NC,L]
RewriteRule ^parcerias(.*)$ parcerias.php [NC,L]
RewriteRule ^planos(.*)$ planos.php [NC,L]
RewriteRule ^perguntas(.*)$ perguntas.php [NC,L]
RewriteRule ^politica(.*)$ politica.php [NC,L]
RewriteRule ^termos(.*)$ termos.php [NC,L]
RewriteRule ^pacotes(.*)$ pacotes.php [NC,L]
RewriteRule ^lista-cursos(.*)$ lista-cursos.php [NC,L]
RewriteRule ^formacoes(.*)$ formacoes.php [NC,L]
RewriteRule ^sistemas(.*)$ sistemas.php [NC,L]
RewriteRule ^cursos-2021(.*)$ cursos-2021.php [NC,L]
RewriteRule ^cursos-2022(.*)$ cursos-2022.php [NC,L]
RewriteRule ^linguagens(.*)$ linguagens.php [NC,L]
RewriteRule ^cursos(.*)$ cursos.php [NC,L]
RewriteRule ^categorias(.*)$ categorias.php [NC,L]

# 3. Regras com parâmetros(URLs Diânmicas)
RewriteRule ^curso-de-(.*)$ curso.php?url=$1 [NC,QSA,L]
RewriteRule ^cursos-do-(.*)$ pacote.php?url=$1 [NC,QSA,L]
RewriteRule ^categoria-(.*)$ categoria.php?url=$1 [NC,QSA,L]
RewriteRule ^linguagem-(.*)$ linguagem.php?url=$1 [NC,QSA,L]

# 4. Fallback: se não for nada acima, envia para o index

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L]